---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Calendars — doon.today">
  <section class="simple-page">
    <p class="eyebrow">DOON.TODAY</p><h1>Calendars</h1>
    <p class="lede">Subscribe once and let upcoming Doon events appear in your calendar.</p>
    <p><a class="primary-link" href="/calendar.ics">Subscribe to the curated calendar →</a></p>
    <div class="calendar-grid">
      <section><h2>Collections</h2><a href="/">Curated</a><span>Music</span><span>Books</span><span>Outdoors</span><span>Culture</span></section>
      <section><h2>Sources</h2><span>District</span><span>BookMyShow</span><span>AllEvents</span><span>Townscript</span><span>r/Dehradun</span></section>
    </div>
  </section>
</BaseLayout>
